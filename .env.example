# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS; must never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner access for writing. SERVER ONLY. Without both, nobody can sign in or save.
APP_PIN=choose-a-6-digit-pin
# Signs the session cookie: `openssl rand -base64 32`
AUTH_SECRET=generate-a-long-random-string

# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model
# GEMINI_MODEL=
